# uv 虚拟环境（由 uv.lock + pyproject.toml 重建）
.venv/
# .venv 符号链接（指向统一 .venv，git 视符号链接为文件，需单独匹配）
*.venv

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 生成物（ER 图、流程图 PNG 等）
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# 本地导出文件
*.docx
*.md.docx
*.zip
*.tar.gz

# 系统文件
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 日志
*.log

# Windows Alternate Data Streams (WSL 与 Windows 交互产生的元数据)
*:*
*Zone.Identifier

# gitcode-workflow shared ignore rules
logs/
*.py[cod]
venv/
.coverage
dist/

# md-to-thesis-latex 输出产物（避免仓库污染）
thesis/

# LaTeX 编译中间文件
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# skills 临时目录
tmp/

# 论文提取输出产物（个人文件，不提交）
output/

# skill 评估工作区（临时评估数据，skill-creator 评估残留）
*-workspace/
doubao-vision-workspace/

# Claude Code 本地设置（机器相关，不纳入版本控制）
.claude/settings.local.json

# OpenCode / OhMyOpenCode 运行期元数据（机器相关）
.omo/

# ──────────────────────────────────────────────────────────
# SKILL 重型 venv / 模型缓存（不可提交，单个体积 500MB-5GB+）
# ──────────────────────────────────────────────────────────

# paper-reader 独立 venvs（marker 5.1GB / mineru 613MB，含 GPU 模型权重）
paper-reader/venvs/

# paper-reader 运行期数据缓存
paper-reader/data/

# db-skill 独立 venv（应改为符号链接到统一 .venv，当前独立 venv 临时忽略）
db-skill/.venv/

# 任意 skill 内部的独立 venv 目录（防新增 skill 自建 venv）
**/venvs/
**/node_modules/

# ──────────────────────────────────────────────────────────
# 孤儿目录 / 半成品 skill（无 SKILL.md 的废弃目录）
# ──────────────────────────────────────────────────────────

# diagram-usecase-overview 缺 SKILL.md，仅有 scripts/，属半成品
diagram-usecase-overview/

# 归档目录（保留代码但不作为活动 skill）
archive/

# ──────────────────────────────────────────────────────────
# 统一 SKILL 输出目录（运行期产物，不提交；规范见 docs/specs/OUTPUT.md）
# ──────────────────────────────────────────────────────────

# 当 skill 输出到 ~/.claude/skills-output/ 时的兜底目录
skills-output/

# unified-search 运行期状态（SQLite 历史 + 配额计数）
unified-search/data/history.db
unified-search/data/quota.json

# 当 skill 输出到当前项目目录时的 thesis-output（仅本仓库自身不提交）
thesis-output/

# 各 skill-output-root 运行期产物（OUTPUT.md §skill-output-root；修复 W1：
# 此前仅 thesis-output/ 入表，主库内误跑会写进 git 仓库——2026-09-24 补齐）
db-output/
doc-output/
unified-search-output/

# 中间产物统一目录（OUTPUT.md C-5：<输出根>/.work/<skill-name>/）
.work/

# paper-reader 默认输出目录
paper-analysis/

# WSL UNC path test artifacts (pytest PID/log files from detached/UNC tests)
# Paths contain literal backslashes (WSL UNC paths) and no forward slashes,
# so git treats them as single filenames — must use * globs for substring matching.
*wsl$*
*wsl.localhost*

# github-workflow shared ignore rules
unified-search/data/dblp_cookies.json
