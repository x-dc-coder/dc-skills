#!/usr/bin/env bash
# dc-skills 提交门禁（方案B，2026-10-15）
#   1) mdlineage check --changed   失效 Markdown 链接拦截（写作规范 B10 的执行器，秒级）
#   2) 路由不变量测试               入口 description / 正文不得指向已删除族/技能
#   3) skills-sync --check         agent-map.yaml 与各 Agent 软链农场零漂移
# 启用：git config core.hooksPath githooks（跨设备搭建.md §三）
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v mdlineage >/dev/null 2>&1; then
    echo "✗ pre-commit: mdlineage 不在 PATH（安装见 docs/runbook/跨设备搭建.md）" >&2
    exit 1
fi

echo "[pre-commit] 1/3 mdlineage check --changed"
mdlineage check --changed

echo "[pre-commit] 2/3 路由不变量"
uv run pytest dc-skill-creator/scripts/test_route_invariants.py -q

echo "[pre-commit] 3/3 农场漂移"
uv run python scripts/skills-sync --check >/dev/null

echo "[pre-commit] ✅ 通过"
