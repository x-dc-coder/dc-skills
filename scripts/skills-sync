#!/usr/bin/env python3
"""skills-sync — 按 agent-map.yaml 物化各 Agent 的技能软链接农场。

语义：
- master（本仓库根）是唯一物理技能目录；每个 agent 的 skills 目录只放启用技能的软链接。
- 只管理指向 master 的软链接：补齐缺失的、移除不在清单里的。
- 农场里的真实目录（如安装器着陆产物）与非 master 软链接（vendor/预设技能）一律不碰。

用法：
  cd ~/projects/dc-skills && uv run python scripts/skills-sync          # 物化并报告
  uv run python scripts/skills-sync --check                            # 只检查漂移，不修改
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "agent-map.yaml"


def expand(p: str) -> Path:
    return Path(os.path.expanduser(p))


def load_manifest() -> dict:
    if not MANIFEST.exists():
        sys.exit(f"缺少清单文件: {MANIFEST}")
    return yaml.safe_load(MANIFEST.read_text(encoding="utf-8"))


def under_master(target: Path, master: Path) -> bool:
    try:
        target.relative_to(master)
        return True
    except ValueError:
        return False


def resolve_names(value, base: set[str]) -> set[str]:
    """skills 字段接受 'base' 引用或显式列表。"""
    if value is None:
        return set(base)
    if isinstance(value, str):
        if value == "base":
            return set(base)
        sys.exit(f"skills 期望列表或 'base'，得到: {value!r}")
    return set(value)


def sync_farm(farm_dir: str, names: set[str], master: Path, check: bool) -> list[str]:
    farm = expand(farm_dir)
    actions: list[str] = []
    farm.mkdir(parents=True, exist_ok=True)

    # 1) 清理：指向 master 但不在启用清单里的软链接
    for entry in sorted(farm.iterdir()):
        if not entry.is_symlink():
            continue  # 真实目录（安装器着陆区产物）不动
        if not under_master(Path(os.path.realpath(entry)), master):
            continue  # 非 master 链接（vendor/预设技能）不动
        if entry.name not in names:
            actions.append(f"  - 移除 {entry} -> {os.readlink(entry)}")
            if not check:
                entry.unlink()

    # 2) 补齐：启用清单里的技能
    for name in sorted(names):
        src = master / name
        if not src.is_dir():
            actions.append(f"  ! 缺失技能目录: {src}")
            continue
        link = farm / name
        if link.is_symlink() and Path(os.path.realpath(link)) == src.resolve():
            continue
        if link.exists() and not link.is_symlink():
            actions.append(f"  ! 跳过（真实目录已占用）: {link}")
            continue
        actions.append(f"  + 链接 {link} -> {src}")
        if not check:
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(src)
    return actions


def check_families(m: dict, master: Path) -> list[str]:
    """族群标记一致性（2026-09-24）：member ⇔ load-mode:manual + disable-model-invocation
    + Codex openai.yaml（allow_implicit_invocation:false）；entry ⇔ role:entry 且非 manual。
    返回问题行列表（空=一致）。"""
    import re as _re

    import yaml as _yaml

    def frontmatter(skill_dir: Path) -> dict:
        txt = (skill_dir / "SKILL.md").read_text(encoding="utf-8", errors="replace")
        mt = _re.match(r"^---\r?\n([\s\S]*?)\r?\n---", txt)
        if not mt:
            return {}
        try:
            return _yaml.safe_load(mt.group(1)) or {}
        except _yaml.YAMLError:
            return {"__yaml_error__": True}

    problems: list[str] = []
    for fname, f in sorted((m.get("families") or {}).items()):
        entry, members = f.get("entry"), list(f.get("members") or [])
        for name, role in [(entry, "entry")] + [(x, "member") for x in members]:
            d = master / name
            if not d.is_dir():
                problems.append(f"  ! [{fname}] {role} {name}: 目录缺失")
                continue
            fm = frontmatter(d)
            if fm.get("__yaml_error__") or not fm:
                problems.append(f"  ! [{fname}] {role} {name}: frontmatter 缺失或 YAML 错误")
                continue
            meta = fm.get("metadata") or {}
            if meta.get("family") != fname or meta.get("role") != role:
                problems.append(f"  ! [{fname}] {role} {name}: metadata.family/role 应为 {fname}/{role}")
            dmi = fm.get("disable-model-invocation") is True
            if role == "member":
                if meta.get("load-mode") != "manual":
                    problems.append(f"  ! [{fname}] member {name}: load-mode 应为 manual")
                if not dmi:
                    problems.append(f"  ! [{fname}] member {name}: 缺 disable-model-invocation: true")
                oa = d / "agents" / "openai.yaml"
                if not oa.exists():
                    problems.append(f"  ! [{fname}] member {name}: 缺 agents/openai.yaml")
                else:
                    try:
                        od = _yaml.safe_load(oa.read_text(encoding="utf-8")) or {}
                        if (od.get("policy") or {}).get("allow_implicit_invocation") is not False:
                            problems.append(f"  ! [{fname}] member {name}: openai.yaml 未禁隐式调用")
                    except _yaml.YAMLError:
                        problems.append(f"  ! [{fname}] member {name}: openai.yaml YAML 错误")
            else:
                if dmi:
                    problems.append(f"  ! [{fname}] entry {name}: 不应有 disable-model-invocation")
                if meta.get("load-mode") == "manual":
                    problems.append(f"  ! [{fname}] entry {name}: load-mode 不应为 manual")
    return problems


def main() -> None:
    ap = argparse.ArgumentParser(description="按 agent-map.yaml 物化技能农场")
    ap.add_argument("--check", action="store_true", help="只检查漂移，不修改")
    args = ap.parse_args()

    m = load_manifest()
    master = expand(m["master"])
    if not master.is_dir():
        sys.exit(f"master 不存在: {master}")
    base = set(m.get("base") or [])
    on_demand = set(m.get("on_demand") or [])

    for agent_name, cfg in (m.get("agents") or {}).items():
        names = resolve_names(cfg.get("skills"), base)
        for extra in cfg.get("extra") or []:
            if extra not in on_demand and extra not in base:
                print(f"! [{agent_name}] extra 中的未知技能: {extra}")
            names.add(extra)
        print(f"[{agent_name}] {expand(cfg['dir'])}")
        for line in sync_farm(cfg["dir"], names, master, args.check):
            print(line)
        for preset_name, preset in (cfg.get("presets") or {}).items():
            print(f"[{agent_name}/{preset_name}] {expand(preset['dir'])}")
            for line in sync_farm(preset["dir"], set(preset["skills"]), master, args.check):
                print(line)

    fam_problems = check_families(m, master)
    if fam_problems:
        print("[families] 族群标记一致性问题:")
        for line in fam_problems:
            print(line)
    elif m.get("families"):
        n_member = sum(len(f.get("members") or []) for f in m["families"].values())
        print(f"[families] {len(m['families'])} 族 / {n_member} 成员标记一致"
              "（member ⇔ manual + openai.yaml）")

    print("check 模式，未做修改" if args.check else "农场物化完成")


if __name__ == "__main__":
    main()
