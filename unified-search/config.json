{
  "_comment": "Unified Search Skill 配置文件。API keys 优先从环境变量读取，其次从此处。Tavily/Firecrawl 每月 1000 次额度，请勿浪费。",
  "api_keys": {
    "tavily": {
      "env_var": "TAVILY_API_KEY",
      "value": null
    },
    "firecrawl": {
      "env_var": "FIRECRAWL_API_KEY",
      "value": null
    },
    "semantic_scholar": {
      "env_var": "S2_API_KEY",
      "value": null
    },
    "bocha": {
      "env_var": "BOCHA_API_KEY",
      "value": null
    },
    "ai4scholar": {
      "env_var": "AI4SCHOLAR_API_KEY",
      "value": null
    },
    "zhipu": {
      "env_var": "ZHIPU_API_KEY",
      "value": null
    }
  },
  "quota": {
    "tavily": {
      "monthly_limit": 1000,
      "strategy": "reserve_for_advanced_and_arbitration"
    },
    "firecrawl": {
      "monthly_limit": 1000,
      "strategy": "reserve_for_content_extraction"
    },
    "zhipu": {
      "monthly_limit": 2000,
      "strategy": "soft_cap_local_only"
    }
  },
  "sources": {
    "keenable": {
      "enabled": true,
      "type": "cli",
      "command": "keenable",
      "roles": [
        "general",
        "news",
        "technical",
        "arbitration"
      ],
      "weight": 1.0,
      "cost": 0,
      "timeout_sec": 20
    },
    "tavily": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://api.tavily.com/search",
      "roles": [
        "general",
        "news",
        "technical",
        "arbitration"
      ],
      "weight": 1.3,
      "cost": 1,
      "timeout_sec": 30,
      "default_params": {
        "search_depth": "basic",
        "max_results": 8,
        "include_answer": true,
        "topic": "general"
      },
      "advanced_params": {
        "search_depth": "advanced",
        "max_results": 10,
        "include_answer": true,
        "chunks_per_source": 3
      }
    },
    "firecrawl": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://api.firecrawl.dev/v2/search",
      "roles": [
        "general",
        "technical",
        "content_extraction"
      ],
      "weight": 1.1,
      "cost": 1,
      "timeout_sec": 40,
      "default_params": {
        "limit": 8,
        "scrapeOptions": {
          "formats": [
            "markdown"
          ]
        }
      }
    },
    "bocha": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://api.bochaai.com/v1/web-search",
      "roles": [
        "general",
        "news",
        "technical"
      ],
      "weight": 1.2,
      "cost": 1,
      "timeout_sec": 30,
      "default_params": {
        "freshness": "oneYear",
        "summary": true,
        "count": 10
      }
    },
    "arxiv": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://export.arxiv.org/api/query",
      "roles": [
        "academic"
      ],
      "weight": 1.5,
      "cost": 0,
      "timeout_sec": 25,
      "rate_limit_sec": 3,
      "default_params": {
        "start": 0,
        "max_results": 15,
        "sortBy": "relevance",
        "sortOrder": "descending"
      }
    },
    "dblp": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://dblp.org/search/publ/api",
      "roles": [
        "academic"
      ],
      "weight": 1.3,
      "cost": 0,
      "timeout_sec": 20,
      "default_params": {
        "format": "json",
        "h": 15,
        "f": 0
      }
    },
    "semantic_scholar": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://api.semanticscholar.org/graph/v1/paper/search",
      "roles": [
        "academic"
      ],
      "weight": 1.4,
      "cost": 0,
      "timeout_sec": 25,
      "default_params": {
        "limit": 15,
        "offset": 0,
        "fields": "title,authors,year,abstract,openAccessPdf,url,externalIds,venue,citationCount"
      }
    },
    "openalex": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://api.openalex.org/works",
      "roles": [
        "academic"
      ],
      "weight": 1.35,
      "cost": 0,
      "timeout_sec": 25,
      "mailto": "unified-search@example.com",
      "default_params": {
        "per-page": 15
      },
      "_comment": "免费无需 key；dblp 人机墙 / arxiv API 限流时的学术检索主力替代源"
    },
    "ai4scholar": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://ai4scholar.net/graph/v1/paper/search",
      "roles": [
        "academic"
      ],
      "weight": 1.45,
      "cost": 1,
      "timeout_sec": 25,
      "key_env_var": "AI4SCHOLAR_API_KEY",
      "credits_endpoint": "https://ai4scholar.net/api/credits",
      "default_params": {
        "fields": "paperId,title,abstract,authors,year,venue,citationCount,externalIds,openAccessPdf,url"
      },
      "_comment": "Ai4Scholar 开放 API：S2 语料 2 亿+；Bearer 认证；每次成功调用扣积分(1分起)，x-credits-remaining 可对账；PDF 下载需本地 stdio MCP（见 scripts/ai4scholar_download.py）"
    },
    "zhipu": {
      "enabled": true,
      "type": "http",
      "endpoint": "https://open.bigmodel.cn/api/paas/v4/web_search",
      "roles": [
        "general",
        "news",
        "technical",
        "arbitration"
      ],
      "weight": 1.2,
      "cost": 1,
      "timeout_sec": 30,
      "default_params": {
        "search_engine": "search_std",
        "count": 8
      }
    }
  },
  "modes": {
    "general": {
      "_comment": "通用搜索：多源对比，有出入则启用第 3 源仲裁（zhipu=智谱 web_search，套餐 Key 按次计积分）",
      "primary_pair": [
        "keenable",
        "tavily"
      ],
      "tier_sources": {
        "_comment": "性价比 tier 用免费/便宜源，旗舰 tier 用高质量源",
        "value": [
          "keenable",
          "bocha",
          "zhipu"
        ],
        "flagship": [
          "tavily",
          "bocha",
          "zhipu"
        ]
      },
      "arbitrator": "firecrawl",
      "max_results_per_source": 8,
      "agreement_threshold": 0.4,
      "_agreement_threshold_comment": "两源结果重叠率低于此值则触发仲裁"
    },
    "academic": {
      "_comment": "学术搜索：6 源并行（arxiv 官方 API 429 时降级 HTML；dblp 有 Anubis 人机墙时自动过墙；semantic_scholar 建议配 S2_API_KEY；openalex 免费兜底；ai4scholar 按 S2 积分计费；zhipu 中文学术资讯补充），论文链接留痕",
      "sources": [
        "arxiv",
        "dblp",
        "semantic_scholar",
        "openalex",
        "ai4scholar",
        "zhipu"
      ],
      "max_results_per_source": 15,
      "record_papers": true
    }
  },
  "fetch": {
    "_comment": "网页抓取能力，按优势分工",
    "default": "keenable",
    "strategies": {
      "markdown_body": {
        "_comment": "正文抓取首选 Firecrawl，质量最高",
        "primary": "firecrawl",
        "fallback": "keenable"
      },
      "fast_summary": {
        "_comment": "快速摘要用 Keenable，免费无额度",
        "primary": "keenable",
        "fallback": null
      },
      "ai_extract": {
        "_comment": "AI 提取用 Tavily extract，消耗额度",
        "primary": "tavily",
        "fallback": "firecrawl"
      }
    }
  },
  "history": {
    "enabled": true,
    "db_path": "data/history.db",
    "_comment": "只记录多源并行搜索中 deemed 最准确/最有价值的结果",
    "selection_rule": "保留每条查询 top-5 结果；学术模式额外保留所有论文链接"
  }
}
